{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ESNext", "DOM"],
        "outDir": "lib",
        "rootDir": "src",
        "sourceMap": true,
        "typeRoots": ["src/@types", "../../node_modules/@types"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "lib", "**/*.spec.ts"]
}
